# Copy to .env and fill in your key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=false

# Pinecone — property search + applicant CRM persistence
# Leave blank to use in-memory fallback for both
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=lettingcopilot-properties
PINECONE_APPLICANTS_INDEX=applicants

# Model (free tier supports gemini-2.0-flash and gemini-1.5-flash)
AVA_MODEL=gemini-2.0-flash

# App
ENVIRONMENT=dev
PORT=8080
